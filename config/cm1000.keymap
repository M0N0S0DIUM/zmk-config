/*
 * CM1000 Keymap Overlay
 * Modern ZMK keymap overlay format
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        encoder_vol: sensor_rotate_vol {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&kp C_VOL_DN>, <&kp C_VOL_UP>;
        };

        power_mod_morph: power_mod_morph {
            compatible = "zmk,behavior-mod-morph";
            label = "POWER_MOD_MORPH";
            bindings = <&tog 1>, <&soft_off>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        boot_loader: boot_loader {
            compatible = "zmk,behavior-tap-dance";
            label = "BOOT_LOADER";
            #binding-cells = <0>;
            tapping-term-ms = <1000>;
            bindings =
                <&kp F12>,
                <&kp F12>,
                <&kp F12>,
                <&kp F12>,
                <&bootloader>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESCAPE  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &boot_loader  &power_mod_morph  &kp GRAVE  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp MINUS  &kp EQUAL  &kp BSPC  &kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH  &kp DELETE  &kp PAGE_UP  &kp PAGE_DOWN  &kp CAPSLOCK  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SEMICOLON  &kp SQT  &kp ENTER  &kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &kp SLASH  &kp RIGHT_SHIFT  &kp UP_ARROW  &kp LEFT_CONTROL  &kp LEFT_GUI  &kp LEFT_ALT  &kp SPACE  &kp RIGHT_ALT  &kp RIGHT_GUI  &kp K_MENU  &kp RIGHT_CONTROL  &kp LEFT  &kp DOWN  &kp RIGHT
            >;

            sensor-bindings = <&encoder_vol>;
        };

        control_layer {
            bindings = <
&bt BT_CLR_ALL  &studio_unlock  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &rgb_ug RGB_COLOR_HSB(0,0,100)  &rgb_ug RGB_COLOR_HSB(0,100,50)  &rgb_ug RGB_COLOR_HSB(26,100,50)  &rgb_ug RGB_COLOR_HSB(62,100,50)  &rgb_ug RGB_COLOR_HSB(112,100,49)  &rgb_ug RGB_COLOR_HSB(211,100,50)  &rgb_ug RGB_COLOR_HSB(228,100,50)  &rgb_ug RGB_COLOR_HSB(291,100,50)  &rgb_ug RGB_COLOR_HSB(177,32,45)  &rgb_ug RGB_COLOR_HSB(177,34,22)  &trans  &rgb_ug RGB_BRI  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &rgb_ug RGB_SPD  &rgb_ug RGB_BRD  &rgb_ug RGB_SPI
            >;
        };
    };
};
